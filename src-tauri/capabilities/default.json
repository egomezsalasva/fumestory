{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "enables the default permissions",
	"windows": ["main"],
	"remote": {
		"urls": ["http://localhost:3000"]
	},
	"permissions": [
		"core:default",
		"core:window:allow-close",
		"opener:default",
		{
			"identifier": "opener:allow-open-url",
			"allow": [
				{ "url": "https://fumestory.com/**" }
			]
		}
	]
}